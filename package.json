{
  "name": "simple-event-handler",
  "version": "1.0.0",
  "description": "Event handler library for both: frontend and backend",
  "main": "src/simple-event-handler.js",
  "scripts": {
    "test": "karma start karma.conf.js && mocha -R spec test/module.test.js",
    "build": "rollup -c",
    "build:watch": "rollup -c --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean && mkdir -p dist",
    "prepublishOnly": "npm test && npm run build"
  },
  "files": [
    "src/",
    "dist/",
    "README.MD",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlavrynovych/event-handler.git"
  },
  "keywords": [
    "event",
    "handler",
    "subscriber",
    "subscription"
  ],
  "author": "Volodymyr Lavrynovych <volodyalavrynovych@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vlavrynovych/event-handler/issues"
  },
  "homepage": "https://github.com/vlavrynovych/event-handler#readme",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "angular": "^1.8.3",
    "angular-mocks": "^1.8.3",
    "jasmine-core": "^5.1.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "mocha": "^10.7.3",
    "rollup": "^4.56.0"
  }
}
