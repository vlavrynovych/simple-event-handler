{
  "name": "simple-event-handler",
  "version": "1.0.0",
  "description": "Event handler library for both: frontend and backend",
  "main": "src/simple-event-handler.js",
  "types": "src/simple-event-handler.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "build": "rollup -c",
    "build:watch": "rollup -c --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean && mkdir -p dist",
    "prepublishOnly": "npm test && npm run build"
  },
  "files": [
    "src/",
    "dist/",
    "README.MD",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlavrynovych/event-handler.git"
  },
  "keywords": [
    "event",
    "handler",
    "subscriber",
    "subscription"
  ],
  "author": "Volodymyr Lavrynovych <volodyalavrynovych@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vlavrynovych/event-handler/issues"
  },
  "homepage": "https://github.com/vlavrynovych/event-handler#readme",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "happy-dom": "^20.3.4",
    "rollup": "^4.56.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
